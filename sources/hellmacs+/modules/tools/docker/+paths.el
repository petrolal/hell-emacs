;; Which container CLI the module runs, shared by config.el and doctor.el.

(defun hellmacs-docker-cli ()
  "The container CLI on the PATH: \"docker\", else \"podman\" when only it is.
\"docker\" when neither is, so the error names what's missing."
  (if (and (not (executable-find "docker")) (executable-find "podman"))
      "podman"
    "docker"))
