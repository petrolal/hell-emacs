;;; Commentary:
;; Distraction-free zen writing and centered buffers via olivetti.

;;; Code:

(declare-function olivetti-mode "olivetti" (&optional arg))

(use-package olivetti
  :defer t
  :commands (olivetti-mode)
  :init
  (hell-leader-def
    "t z" '("zen mode" . olivetti-mode)))

(provide 'ui-zen-config)
