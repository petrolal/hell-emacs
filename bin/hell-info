;; `bin/hell info' (Doom's `doom info'): Hell Emacs, Emacs, the system
;; and your config, in one block to paste into a bug report. Loaded by
;; `hell-cli-main' when the command runs, or run directly through
;; bin/hellscript. Lives outside `load-path'; see `hell-cli-load'.

;;; Code:

(defun hell-cli-info--os ()
  "The operating system's name, as /etc/os-release has it, else `system-type'."
  (or (when (file-readable-p "/etc/os-release")
        (with-temp-buffer
          (insert-file-contents "/etc/os-release")
          (when (re-search-forward "^PRETTY_NAME=\"?\\([^\"\n]*\\)" nil t)
            (match-string 1))))
      (symbol-name system-type)))

(defun hell-cli-info (&rest _)
  "Print Hell Emacs', Emacs', the system's and the config's details."
  (let ((described (hell-process-output "git" "-C" hell-dir "describe" "--tags" "--always" "--dirty"))
        (init-file (hell-init-file)))
    (hell-cli--say "hell-emacs %s%s, channel %s" hell-version
                   (if (zerop (car described)) (format " (%s)" (cdr described)) "")
                       hell-upgrade-channel)
    (hell-cli--say "emacs     %s (%s)" emacs-version
                   (string-join (delq nil (list (and (fboundp 'native-comp-available-p)
                                                         (native-comp-available-p) "native-comp")
                                                    (and (fboundp 'treesit-available-p)
                                                         (treesit-available-p) "tree-sitter")
                                                    (and (fboundp 'igc-info) "igc")
                                                    (and (featurep 'pgtk) "pgtk")))
                                    " "))
    (hell-cli--say "features  %s" system-configuration-features)
    (hell-cli--say "system    %s, %s" (hell-cli-info--os) system-configuration)
    (hell-cli--say "shell     %s" (or (getenv "SHELL") "?"))
    (hell-cli--say "profile   %s: %s" (or hell-profile "default")
                   (if (file-exists-p init-file)
                           (format "synced (%s%s)" (abbreviate-file-name init-file)
                                   (if (file-exists-p (concat init-file "c")) ", compiled" ""))
                         "not synced"))
    (hell-cli--say "install   %s" (abbreviate-file-name hell-dir))
    (hell-cli--say "config    %s%s" (abbreviate-file-name hell-user-dir)
                   (if (file-directory-p hell-user-dir) "" " (doesn't exist: defaults)"))
    (hell-cli--say "modules   %s"
                   (mapconcat (lambda (key)
                                    (let ((flags (hell-module-get key :flags)))
                                      (if flags
                                          (format "(%s %s)" (hell-module-key-string key)
                                                  (mapconcat #'symbol-name flags " "))
                                        (hell-module-key-string key))))
                                  (hell-module-list) " "))
    (hell-cli--say "packages  %s"
                   (if-let* ((profile (hell-profile-read)))
                           (format "%d installed" (length (plist-get profile :load-path)))
                         "?"))
    (hell-cli--say "elpaca    %s" (abbreviate-file-name (expand-file-name "elpaca/" hell-data-dir)))))

;;; hell-info ends here
