# Runs Emacs in batch mode against this checkout; the commands live in
# core/hellmacs-cli.el. Set $EMACS to use a different Emacs binary;
# $HELLMACSDIR and the XDG_*_HOME variables are honored exactly as in
# an interactive session.

set -e

HELLMACS_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
EMACS=${EMACS:-emacs}

# bin/hellmacs --profile NAME COMMAND ...: act on a named profile.
case "$1" in
  -p|--profile)
    [ -n "$2" ] || { echo "bin/hellmacs: $1 needs a profile name" >&2; exit 1; }
    HELLMACS_PROFILE=$2
    export HELLMACS_PROFILE
    shift 2
    ;;
esac

hellmacs() {
  "$EMACS" --batch \
    -l "$HELLMACS_ROOT/early-init.el" \
    --eval "(progn (add-to-list 'load-path hellmacs-core-dir) (require 'hellmacs-cli))" \
    -f hellmacs-cli-main -- "$@"
}

case "$1" in
  test)
    # Tests must never touch your real config, packages or history.
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/hellmacs-test.XXXXXX")
    trap 'rm -rf "$tmp"' EXIT
    XDG_CONFIG_HOME=$tmp/config XDG_DATA_HOME=$tmp/data \
    XDG_CACHE_HOME=$tmp/cache XDG_STATE_HOME=$tmp/state \
    HELLMACSDIR=$tmp/config/hellmacs HELLMACS_PROFILE= \
      hellmacs "$@"
    ;;
  upgrade)
    shift
    case " $* " in
      *" --packages "*) ;;
      # Update Hellmacs first (to its channel: --channel stable|main), then
      # update packages in a fresh Emacs, so that step runs the new code.
      *) hellmacs upgrade-self "$@" ;;
    esac
    hellmacs upgrade "$@"
    ;;
  *)
    hellmacs "$@"
    ;;
esac
