#
# Hellmacs is free software: you can redistribute it and/or modify
# it under the terms of the GNU General Public License as published by
# the Free Software Foundation, either version 3 of the License, or
# (at your option) any later version.
#
# Hellmacs is distributed in the hope that it will be useful,
# but WITHOUT ANY WARRANTY; without even the implied warranty of
# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
# GNU General Public License for more details.
#
# You should have received a copy of the GNU General Public License
# along with this program.  If not, see <https://www.gnu.org/licenses/>.
#
# Runs Emacs in batch mode against this checkout; lisp/hellmacs-cli.el
# dispatches, and each command is bin/hellmacs-COMMAND (as Doom v3's
# bin/doom-COMMAND), which bin/hellmacsscript can also run directly.
#
# Global options come before the command, as `doom's do:
#   -p, --profile NAME     act on a named profile ($HELLMACS_PROFILE)
#   --hellmacsdir DIR      use the config in DIR ($HELLMACSDIR)
#   -D, --debug            debug output and backtraces ($DEBUG)
#   -!, --force            don't ask; accept every prompt ($HELLMACS_FORCE)
# Set $EMACS to use a different Emacs binary; $HELLMACSDIR and the
# XDG_*_HOME variables are honored exactly as in an interactive session.

set -e

HELLMACS_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
case "$EMACS" in *term*) EMACS=emacs ;; *) EMACS=${EMACS:-emacs} ;; esac
command -v "$EMACS" >/dev/null 2>&1 || [ -x "$EMACS" ] || {
  echo "Error: couldn't run Emacs with the command '$EMACS'." >&2
  echo "Is Emacs installed and on your \$PATH? (Or set \$EMACS.)" >&2
  exit 3
}

while [ $# -gt 0 ]; do
  case "$1" in
    -p|--profile)
      [ -n "$2" ] || { echo "bin/hellmacs: $1 needs a profile name" >&2; exit 6; }
      HELLMACS_PROFILE=$2; export HELLMACS_PROFILE; shift 2 ;;
    --profile=*)
      HELLMACS_PROFILE=${1#--profile=}; export HELLMACS_PROFILE; shift ;;
    --hellmacsdir)
      [ -n "$2" ] || { echo "bin/hellmacs: $1 needs a directory" >&2; exit 6; }
      HELLMACSDIR=$2; export HELLMACSDIR; shift 2 ;;
    --hellmacsdir=*)
      HELLMACSDIR=${1#--hellmacsdir=}; export HELLMACSDIR; shift ;;
    -D|--debug)
      DEBUG=1; export DEBUG; shift ;;
    -!|--force)
      HELLMACS_FORCE=1; export HELLMACS_FORCE; shift ;;
    *) break ;;
  esac
done

# As `doom': running as root is almost never what you want -- the files it
# writes would be root's -- unless this checkout is root's own.
if [ "$(id -u)" = 0 ]; then
  owner=$(stat -c %u "$HELLMACS_ROOT" 2>/dev/null || stat -f %u "$HELLMACS_ROOT" 2>/dev/null || echo 0)
  if [ "$owner" != 0 ]; then
    echo "Error: bin/hellmacs was run as root, which would leave files you can't" >&2
    echo "change later. If you really mean root to use Hellmacs, make it the owner:" >&2
    echo "" >&2
    echo "  chown -R root:root $HELLMACS_ROOT" >&2
    exit 2
  fi
fi

# Whether a person is there to answer prompts (`install' asks some).
[ -t 0 ] && [ -t 1 ] && { __HELLMACSTTY=1; export __HELLMACSTTY; }

hellmacs() {
  "$EMACS" --batch \
    -l "$HELLMACS_ROOT/early-init.el" \
    --eval "(require 'hellmacs-cli)" \
    -f hellmacs-cli-main -- "$@"
}

case "$1" in
  emacs)
    # Emacs itself, on this checkout (and profile). --vanilla: Emacs with
    # no config at all (emacs -Q), to tell Hellmacs' problems from Emacs'.
    shift
    case "$1" in
      --vanilla) shift; exec "$EMACS" -Q "$@" ;;
    esac
    [ "$1" = "--" ] && shift
    exec "$EMACS" --init-directory "$HELLMACS_ROOT" \
      ${HELLMACS_PROFILE:+--profile "$HELLMACS_PROFILE"} "$@"
    ;;
  test)
    # Tests must never touch your real config, packages or history.
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/hellmacs-test.XXXXXX")
    trap 'rm -rf "$tmp"' EXIT
    XDG_CONFIG_HOME=$tmp/config XDG_DATA_HOME=$tmp/data \
    XDG_CACHE_HOME=$tmp/cache XDG_STATE_HOME=$tmp/state \
    HELLMACSDIR=$tmp/config/hellmacs HELLMACS_PROFILE= \
      hellmacs "$@"
    ;;
  upgrade|up)
    shift
    case " $* " in
      *" --packages "*) ;;
      # Update Hellmacs first (to its channel: --channel stable|main), then
      # update packages in a fresh Emacs, so that step runs the new code.
      *) hellmacs upgrade-self "$@" ;;
    esac
    hellmacs upgrade "$@"
    ;;
  *)
    hellmacs "$@"
    ;;
esac
