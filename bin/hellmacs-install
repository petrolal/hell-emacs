;; `bin/hellmacs install' (Doom v3's bin/doom-COMMAND files): loaded by
;; `hellmacs-cli-main' when the command runs, or run directly through
;; bin/hellmacsscript. Lives outside `load-path'; see `hellmacs-cli-load'.

;;; Code:

(hellmacs-cli-load "env" "doctor")

(defcli! install (&rest args)
  "First-time setup, as `doom install'. Idempotent: safe to run again.

Options:
  --[no-]config       Create or skip creating your config directory (~/.config/hellmacs)
  --[no-]env          Save or skip saving your shell environment for Emacs
  --[no-]install      Sync immediately or skip syncing packages and profile
  --aot               Native-compile installed packages ahead of time
  --team URL          Configure shared team layer from git repository or directory URL
  --from-bundle FILE  Install from an offline bundle, with no network access

  1. create your config (`hellmacs-user-dir', ~/.config/hellmacs) with
     starter init.el, config.el and packages.el (static/*.example.el),
     unless it exists or --no-config;
  2. if --team, clone or copy the shared enterprise team layer;
  3. offer to save your shell environment (`env'); --env and --no-env
     answer for you;
  4. sync: install the packages your modules declare, and generate the
     init file (--no-install skips it; run `sync' later);
  5. if --aot, native-compile packages ahead of time;
  6. run `doctor'."
  (let* ((bundle (hellmacs-cli--option args "--from-bundle"))
         (team (hellmacs-cli--option args "--team"))
         (config (hellmacs-cli--flag args "config"))
         (env (hellmacs-cli--flag args "env"))
         (install (hellmacs-cli--flag args "install"))
         (aot (member "--aot" args))
         (hellmacs-net-offline (and bundle t)))
    (hellmacs-cli--say "Installing Hellmacs in %s%s" (abbreviate-file-name hellmacs-dir)
                       (if bundle ", offline" ""))
    ;; Emacs loads these instead of Hellmacs, so warn before anything else.
    (dolist (file '("~/.emacs" "~/.emacs.el" "~/_emacs"))
      (when (file-exists-p file)
        (hellmacs-cli--say "  ! %s exists: Emacs loads it instead of Hellmacs. Delete or rename it" file)))
    (let ((dot-emacs-d (expand-file-name "~/.emacs.d/")))
      (when (and (file-directory-p dot-emacs-d)
                 (not (file-equal-p dot-emacs-d hellmacs-dir))
                 (file-in-directory-p hellmacs-dir (or (getenv "XDG_CONFIG_HOME") "~/.config")))
        (hellmacs-cli--say "  ! ~/.emacs.d exists, and Emacs prefers it to %s: \
start Emacs with `%s', or move ~/.emacs.d away"
                           (abbreviate-file-name hellmacs-dir)
                           (hellmacs-cli--start-command hellmacs-dir t))))
    (if (eq config 'no)
        (hellmacs-cli--say "  - Not creating your config, as asked (--no-config)")
      (let ((existed (file-directory-p hellmacs-user-dir)))
        (hellmacs-init-user-dir)
        (hellmacs-cli--say "  %s your config in %s"
                           (if existed "Kept" "Created")
                           (abbreviate-file-name hellmacs-user-dir))))
    (when team
      (let ((team-dir (expand-file-name "team/" hellmacs-user-dir)))
        (hellmacs-cli--say "  - Configuring team layer from %s..." team)
        (if (file-directory-p team)
            (progn
              (make-directory (file-name-directory (directory-file-name team-dir)) t)
              (copy-directory team team-dir t t t))
          (unless (zerop (call-process "git" nil nil nil "clone" "--depth" "1" team team-dir))
            (error "Failed to clone team repository %s" team)))
        (setq hellmacs-team-dir team-dir)
        (hellmacs-cli--say "  ✓ Team layer configured in %s" (abbreviate-file-name team-dir))))
    (when bundle
      ;; Without a config directory, there's nowhere for the lock file:
      ;; the packages stay at the bundle's commits anyway.
      (hellmacs-bundle-install bundle (not (file-directory-p hellmacs-user-dir))))
    (if (eq install 'no)
        (hellmacs-cli--say "  - Not syncing, as asked (--no-install); run `bin/hellmacs sync' before starting Emacs")
      (hellmacs-sync)
      (when aot
        (hellmacs-cli--say "  - Native-compiling packages ahead of time (--aot)...")
        (when (and (featurep 'native-compile) (fboundp 'elpaca-native-compile))
          (elpaca-native-compile))))
    (when (pcase env
            ('no nil)
            ('t t)
            (_ (hellmacs-cli--yes-p
                "Save your shell's environment (PATH, JAVA_HOME, ...) for Emacs? \
\(see `bin/hellmacs help')" nil)))
      (hellmacs-cli-env))
    (hellmacs-cli--say "")
    (hellmacs-cli-doctor)
    (hellmacs-cli--say "\nDone. Start Emacs with:  %s" (hellmacs-cli--start-command hellmacs-dir))
    (hellmacs-cli--say "(or `bin/hellmacs emacs'). Put %s on your PATH to run `hellmacs' from anywhere."
                       (abbreviate-file-name (expand-file-name "bin" hellmacs-dir)))))

(defun hellmacs-cli--start-command (dir &optional explicit)
  "How to start Emacs on Hellmacs installed in DIR: plain \"emacs\" when DIR is
the directory Emacs itself uses (~/.emacs.d if there is one, else
~/.config/emacs, a symlink to DIR included), else with --init-directory.
With EXPLICIT, always with --init-directory."
  (let ((own (if (file-directory-p "~/.emacs.d/")
                 "~/.emacs.d/"
               (expand-file-name "emacs/" (or (getenv "XDG_CONFIG_HOME") "~/.config")))))
    (if (and (not explicit) (file-directory-p own) (file-equal-p own dir))
        "emacs"
      (format "emacs --init-directory %s" (abbreviate-file-name (directory-file-name dir))))))

;;; hellmacs-install ends here
