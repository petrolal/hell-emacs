;; `bin/hell version' (Doom v3's bin/doom-COMMAND files): loaded by
;; `hell-cli-main' when the command runs, or run directly through
;; bin/hellscript. Lives outside `load-path'; see `hell-cli-load'.

;;; Code:

(defun hell-cli-version (&rest _)
  "Say Hell Emacs' version (and its commit), its update channel and Emacs'."
  (let ((described (hell-process-output "git" "-C" hell-dir "describe" "--tags" "--always" "--dirty")))
    (hell-cli--say "Hell Emacs %s%s" hell-version
                       (if (zerop (car described)) (format " (%s)" (cdr described)) "")))
  (hell-cli--say "Update channel: %s (`hell-upgrade-channel')" hell-upgrade-channel)
  (hell-cli--say "Emacs %s on %s" emacs-version system-configuration))

;;; hell-version ends here
