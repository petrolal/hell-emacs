;; `bin/hell sbom' (Doom v3's bin/doom-COMMAND files): loaded by
;; `hell-cli-main' when the command runs, or run directly through
;; bin/hellscript. Lives outside `load-path'; see `hell-cli-load'.

;;; Code:

(defcli! sbom (&rest args)
  "Write a CycloneDX bill of materials of everything installed.
ARGS: the file to write it to; without one, it goes to stdout."
  (let ((files (seq-remove (lambda (a) (string-prefix-p "-" a)) args)))
    (when (cdr files)
      (error "Usage: bin/hell sbom [OUT.json]"))
    (let* ((components (hell-compliance-components))
           (json (let ((json-encoding-pretty-print t))
                   (json-encode (hell-compliance-cyclonedx-sbom components)))))
      (if-let* ((out (car files)))
          (progn
            (with-temp-file out (insert json "\n"))
            (hell-cli--say "Wrote %d components to %s" (length components)
                           (abbreviate-file-name (expand-file-name out))))
        (hell-cli--say "%s" json)))))

;;; hell-sbom ends here
