;; `bin/hellmacs info' (Doom's `doom info'): Hellmacs, Emacs, the system
;; and your config, in one block to paste into a bug report. Loaded by
;; `hellmacs-cli-main' when the command runs, or run directly through
;; bin/hellmacsscript. Lives outside `load-path'; see `hellmacs-cli-load'.

;;; Code:

(defun hellmacs-cli-info--os ()
  "The operating system's name, as /etc/os-release has it, else `system-type'."
  (or (when (file-readable-p "/etc/os-release")
        (with-temp-buffer
          (insert-file-contents "/etc/os-release")
          (when (re-search-forward "^PRETTY_NAME=\"?\\([^\"\n]*\\)" nil t)
            (match-string 1))))
      (symbol-name system-type)))

(defun hellmacs-cli-info (&rest _)
  "Print Hellmacs', Emacs', the system's and the config's details."
  (let ((described (hellmacs-cli--run "git" "-C" hellmacs-dir "describe" "--tags" "--always" "--dirty"))
        (init-file (hellmacs-init-file)))
    (hellmacs-cli--say "hellmacs  %s%s, channel %s" hellmacs-version
                       (if (zerop (car described)) (format " (%s)" (cdr described)) "")
                       hellmacs-upgrade-channel)
    (hellmacs-cli--say "emacs     %s (%s)" emacs-version
                       (string-join (delq nil (list (and (fboundp 'native-comp-available-p)
                                                         (native-comp-available-p) "native-comp")
                                                    (and (fboundp 'treesit-available-p)
                                                         (treesit-available-p) "tree-sitter")
                                                    (and (fboundp 'igc-info) "igc")
                                                    (and (featurep 'pgtk) "pgtk")))
                                    " "))
    (hellmacs-cli--say "features  %s" system-configuration-features)
    (hellmacs-cli--say "system    %s, %s" (hellmacs-cli-info--os) system-configuration)
    (hellmacs-cli--say "shell     %s" (or (getenv "SHELL") "?"))
    (hellmacs-cli--say "profile   %s: %s" (or hellmacs-profile "default")
                       (if (file-exists-p init-file)
                           (format "synced (%s%s)" (abbreviate-file-name init-file)
                                   (if (file-exists-p (concat init-file "c")) ", compiled" ""))
                         "not synced"))
    (hellmacs-cli--say "install   %s" (abbreviate-file-name hellmacs-dir))
    (hellmacs-cli--say "config    %s%s" (abbreviate-file-name hellmacs-user-dir)
                       (if (file-directory-p hellmacs-user-dir) "" " (doesn't exist: defaults)"))
    (hellmacs-cli--say "modules   %s"
                       (mapconcat (lambda (key)
                                    (let ((flags (hellmacs-module-get key :flags)))
                                      (if flags
                                          (format "(%s %s)" (hellmacs-module-key-string key)
                                                  (mapconcat #'symbol-name flags " "))
                                        (hellmacs-module-key-string key))))
                                  (hellmacs-module-list) " "))
    (hellmacs-cli--say "packages  %s"
                       (if-let* ((profile (hellmacs-profile-read)))
                           (format "%d installed" (length (plist-get profile :load-path)))
                         "?"))
    (hellmacs-cli--say "elpaca    %s" (abbreviate-file-name (expand-file-name "elpaca/" hellmacs-data-dir)))))

;;; hellmacs-info ends here
