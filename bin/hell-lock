;; `bin/hell lock' (Doom v3's bin/doom-COMMAND files): loaded by
;; `hell-cli-main' when the command runs, or run directly through
;; bin/hellscript. Lives outside `load-path'; see `hell-cli-load'.

;;; Code:

(defun hell-cli--write-lock ()
  "Write `hell-lock-file' for every package Elpaca has queued."
  (defvar elpaca-lock-file-functions)
  (let ((elpaca-lock-file-functions nil)) ; lock everything, not just init-time orders
    (make-directory (file-name-directory hell-lock-file) t)
    (elpaca-write-lock-file hell-lock-file))
  (hell-cli--say "Locked %d packages in %s"
                     (length (elpaca--queued)) (abbreviate-file-name hell-lock-file)))

(defun hell-cli-lock (&rest _)
  "Sync, then record the exact commit of every installed package."
  (hell-sync)
  (hell-cli--write-lock))

;;; hell-lock ends here
