# Dotfiles at the root: only Hell Emacs' own, matching Doom & Centaur Emacs conventions.
/.*
!/.hell-emacs
!/.dir-locals.el
!/.gitignore
!/.github

# Where older Hell Emacs versions or local runs keep packages, state, and caches.
/var/
/etc/
/.local*/
/elpaca/
/elpa/
/cache/
/eln-cache/
/auto-save-list/

# User config in root if $HELLDIR is this checkout.
/*.el
!/early-init.el
!/.dir-locals.el
/user-lisp/
/themes/
/snippets/
/templates/
/modules/*/
!/modules/hell/
/sources/*/
!/sources/hell+/
/profiles/*/
!/profiles/safe-mode/

# Compilation artifacts & shared libraries (native-comp, tree-sitter grammars).
*.elc
*.eln
*.so
*.dll
*.dylib

# Editor, auto-save, lock files, and backups.
*~
\#*\#
.\#*
*.bak
*.orig
*.swp
*.swo

# Runtime state, caches, and custom files.
custom.el
custom-*.el
packages.lock.eld
recentf*
bookmarks*
places*
history*
tramp*
url/
ido.last
projectile.cache
.projectile
.cpcache/
.bloop/
.metals/
.bsp/
.idea/
.vscode/
.elsa/

# Package & backup archives.
*.tar.gz
*.tar.xz
*.tar.zst
*.zip

# OS metadata.
.DS_Store
Thumbs.db
